{
  "name": "dark-chinese-chess",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dark-chess/web dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify:performance": "pnpm build && playwright test --config=playwright.performance.config.ts",
    "build": "pnpm --filter @dark-chess/web build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
