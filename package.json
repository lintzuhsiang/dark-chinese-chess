{
  "name": "dark-chinese-chess",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dark-chess/web dev",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify:performance": "pnpm build && playwright test --config=playwright.performance.config.ts",
    "build": "pnpm --filter @dark-chess/web build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "verify:release": "pnpm build && node verification/release-artifact.mjs",
    "verify:gates": "node verification/quality-gates.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
